-# Browser-local time formatting. Server renders UTC ISO in data-ts; this
-# rewrites each [data-ts] element in the viewer's own timezone. Live rows
-# call window.svxFmtTime(date, withSeconds) directly. Render after the
-# elements it should convert (it runs once, synchronously).
:javascript
  (function() {
    function p(n) { return String(n).padStart(2, '0'); }
    window.svxFmtTime = function(d, withSeconds) {
      if (!(d instanceof Date) || isNaN(d)) d = new Date();
      var s = d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) +
              ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
      return withSeconds ? s + ':' + p(d.getSeconds()) : s;
    };
    document.querySelectorAll('[data-ts]').forEach(function(el) {
      var d = new Date(el.getAttribute('data-ts'));
      if (isNaN(d)) return;
      el.textContent = window.svxFmtTime(d, el.hasAttribute('data-ts-seconds'));
      el.title = d.toISOString().replace('T', ' ').replace(/\.\d+Z$/, ' UTC');
    });
  })();
